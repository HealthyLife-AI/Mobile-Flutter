<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing the app stores leaves the device, neither to the
     Google account backup nor to a new phone. It holds health data (meals,
     measurements) and a session key that only this device can decrypt; the
     server is the source of truth and a sign-in restores everything. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
